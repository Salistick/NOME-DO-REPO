# Copie para .env e preencha somente os logins que deseja usar.
# Cadastre exatamente estes callbacks no app da plataforma correspondente.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8790/callback

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8789/callback

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8791/callback

# Remetente Twitch separado, opcional; campos do app herdam TWITCH_* se vazios.
TWITCH_BOT_CLIENT_ID=
TWITCH_BOT_CLIENT_SECRET=
TWITCH_BOT_REDIRECT_URI=
TWITCH_BOT_LOGIN=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=

# Credenciais Polly são configuradas no aplicativo.
POLLY_VOICE_ID=Camila
POLLY_ENGINE=neural
POLLY_OUTPUT_FORMAT=mp3
POLLY_SAMPLE_RATE=24000
